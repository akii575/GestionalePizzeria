{
  "name": "gestionale-pizzeria",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node scripts/export-menu.js && node scripts/copy-static.js",
    "import-sqlite": "node scripts/import-sqlite.js",
    "printer-terminal": "node scripts/printer-terminal.js",
    "set-admin": "node scripts/set-admin.js",
    "set-delivery": "node scripts/set-delivery.js",
    "set-staff": "node scripts/set-staff.js",
    "test": "node scripts/export-menu.js && node scripts/copy-static.js && node --test",
    "lint": "eslint .",
    "typecheck": "node scripts/check-syntax.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "firebase-admin": "^14.5.0",
    "sql.js": "^1.13.0"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "4.15.9"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  }
}
