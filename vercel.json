{
  "regions": ["cdg1"],
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/", "destination": "/api/router?percorso=pages/index.html" },
    { "source": "/index.html", "destination": "/api/router?percorso=pages/index.html" },
    { "source": "/ordini.html", "destination": "/api/router?percorso=pages/ordini.html" },
    { "source": "/gestionale.html", "destination": "/api/router?percorso=pages/gestionale.html" },
    { "source": "/consegne.html", "destination": "/api/router?percorso=pages/consegne.html" },
    { "source": "/ritiri.html", "destination": "/api/router?percorso=pages/ritiri.html" },
    { "source": "/banco.html", "destination": "/api/router?percorso=pages/banco.html" },
    { "source": "/tavoli.html", "destination": "/api/router?percorso=pages/tavoli.html" },
    { "source": "/menu.html", "destination": "/api/router?percorso=pages/menu.html" },
    { "source": "/api/:path*", "destination": "/api/router?percorso=:path*" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://identitytoolkit.googleapis.com http://127.0.0.1:8765; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
